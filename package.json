{
  "name": "dsh-fleet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Peer-to-peer control plane for DeepSeek Harness: pair DSH instances, share workspace references, keep every byte of data where it already lives.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KagurazakaNyaa/dsh-fleet.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "peer.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
